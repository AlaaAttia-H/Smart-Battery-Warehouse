    {
        "id": "fn_plan",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Combine Plan Display",
        "func": "if (msg.topic && msg.topic.indexOf('current_plan') !== -1) {\n    flow.set('current_plan', msg.payload);\n} else if (msg.topic && msg.topic.indexOf('last_plan') !== -1) {\n    flow.set('last_plan', msg.payload);\n}\n\nvar current = flow.get('current_plan') || 'Waiting for a plan...';\nvar last = flow.get('last_plan') || 'No previous plan available.';\n\nmsg.payload = '### Current Action Plan\\n> ' + current + '\\n\\n---\\n\\n### Previous Plan\\n> ' + last;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 550,
        "y": 540,
        "wires": [
            [
                "ui_plan_markdown"
            ]
        ]
    },
