    {
        "id": "fn_gas",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Format Gas Status",
        "func": "var status = String(msg.payload).toUpperCase();\nvar label, color;\nif (status === 'HIGH' || status === 'ALERT' || status === '1') {\n    label = 'HIGH';\n    color = '#ff0000';\n} else {\n    label = 'NORMAL';\n    color = '#00b500';\n}\nmsg.payload = label;\nmsg.textColor = color;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 550,
        "y": 300,
        "wires": [
            [
                "ui_gas_template"
            ]
        ]
    },
