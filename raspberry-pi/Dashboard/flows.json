    {
        "id": "mqtt_state",
        "type": "mqtt in",
        "z": "tab_dashboard",
        "name": "System State",
        "topic": "warehouse/context/system_state",
        "qos": "0",
        "datatype": "str",
        "broker": "broker_local",
        "inputs": 0,
        "x": 300,
        "y": 100,
        "wires": [
            [
                "101156acd5b036e1"
            ]
        ]
    },
    {
        "id": "101156acd5b036e1",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Format System State",
        "func": "var state = msg.payload.toUpperCase();\nvar label, color;\nif      (state === 'EMERGENCY') { label = 'EMERGENCY'; color = '#ff0000'; }\nelse if (state === 'WARNING')   { label = 'WARNING';   color = '#ff8000'; }\nelse                            { label = 'NORMAL';    color = '#00b500'; }\n\nmsg.payload  = label;\nmsg.ui_update = {color: color};\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 550,
        "y": 100,
        "wires": [
            [
                "ui_state_text"
            ]
        ]
    },
