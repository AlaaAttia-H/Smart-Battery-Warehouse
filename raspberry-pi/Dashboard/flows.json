    {
        "id": "fn_batt",
        "type": "function",
        "z": "tab_dashboard",
        "name": "Format Battery Status",
        "func": "var status = String(msg.payload).toUpperCase();\nvar label, color;\nif (status === 'CRITICAL') {\n    label = 'CRITICAL';\n    color = '#ff0000';\n} else if (status === 'LOW') {\n    label = 'LOW';\n    color = '#ff8000';\n} else {\n    label = 'OK';\n    color = '#00b500';\n}\nmsg.payload = label;\nmsg.textColor = color;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 550,
        "y": 380,
        "wires": [
