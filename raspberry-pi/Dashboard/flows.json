        "height": "3",
        "head": "",
        "format": "<div style=\"display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%;\">\n    <div style=\"color: #000000; font-size: 1rem; margin-bottom: 4px; font-family: Helvetica; font-weight: bold;\">\n        Gas Status\n    </div>\n    <div :style=\"{ color: msg.textColor, fontSize: '28px', fontWeight: 'bold' }\">\n        {{ msg.payload }}\n    </div>\n</div>",
